# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchmaker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=matchmaker
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudflare R2 / AWS S3 Compatible Storage Configuration
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_BUCKET_NAME=anonymous-matchmaker-storage
PUBLIC_STORAGE_URL=https://pub-xxxxxx.r2.dev
